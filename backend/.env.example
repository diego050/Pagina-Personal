# Copy this file to .env and fill in the real values.
# .env is gitignored and must NEVER be committed -- this repository is public.
#
# In production, docker-compose.prod.yml loads this file via `env_file`.
# Every secret belongs here; the committed compose file only carries
# non-secret, environment-specific values (DATABASE_URL, FRONTEND_URL).

# Security
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin credentials.
# NOTE: these only create the user the FIRST time the database is empty
# (see on_startup in main.py). Changing them later does NOT change the
# password of an admin user that already exists in the database.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Email delivery (Resend) -- https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. Do not wrap the value in quotes.
# onboarding@resend.dev works without verifying a domain, but Resend will ONLY
# deliver to the email address that owns the Resend account.
# To send anywhere, verify a domain in Resend and use e.g. "DBtech <contacto@dbtech.cloud>".
RESEND_FROM=DBtech Portfolio <onboarding@resend.dev>

# Where contact-form and newsletter notifications are delivered.
CONTACT_RECIPIENT=your@email.com

# Deployment (overridden in production by docker-compose.prod.yml)
FRONTEND_URL=https://diegovelazquez.dev
